# =============================================================================
# MedEscala — variáveis de ambiente
#
# Copie para `apps/api/.env` e preencha. NUNCA comite `.env` (§13 do guia).
# Os valores de chave abaixo são placeholders: rode `pnpm exec supabase status`
# depois do `supabase start` e copie as chaves que ele imprime.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco — Prisma (ADR-003)
# -----------------------------------------------------------------------------
# A stack local do Supabase expõe o Postgres 17 na porta 54322.
#
# ATENÇÃO ao migrar para o Supabase Cloud: o pooler (porta 6543) NÃO suporta os
# prepared statements que o Prisma usa. Migrations precisam da conexão DIRETA
# (5432) e o runtime precisa de `directUrl` apontando para ela. Em local as duas
# variáveis apontam para o mesmo lugar porque não há pooler no caminho.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------
SUPABASE_URL="http://127.0.0.1:54321"

# Chave pública. A api a usa para o fluxo de login (senha do usuário).
SUPABASE_ANON_KEY="cole-aqui-o-anon-key-do-supabase-status"

# Chave de serviço: ignora RLS. Só a api pode ter isto (D2 — o web NUNCA fala
# direto com o Supabase). Se esta chave chegar ao frontend, todo o controle de
# acesso do ADR-006 deixa de valer.
SUPABASE_SERVICE_ROLE_KEY="cole-aqui-o-service-role-key-do-supabase-status"

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Origem permitida do frontend. Usada pelo CORS e pela validação de `Origin`
# das rotas de mutação (D9 — camada anti-CSRF).
WEB_ORIGIN="http://localhost:5173"

# Segredo para assinar o cookie de CSRF. Gere um valor aleatório por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"

# -----------------------------------------------------------------------------
# Seed (apenas desenvolvimento e testes)
# -----------------------------------------------------------------------------
# Senha dos usuários criados pelo `pnpm db:seed`. Mínimo de 8 caracteres para
# bater com `minimum_password_length` do supabase/config.toml e com
# SENHA_TAMANHO_MINIMO de @medescala/contracts.
SEED_SENHA_PADRAO="medescala123"

# -----------------------------------------------------------------------------
# Redis (ADR-027) — sobe com `docker compose up -d` (ou `pnpm dev:infra`)
# -----------------------------------------------------------------------------
# Só acelera a fila de convites: o prazo de cada convite mora no Postgres
# (DEC-097). Com o Redis fora, a fila anda no próximo acesso, não trava.
REDIS_URL="redis://127.0.0.1:6379"
